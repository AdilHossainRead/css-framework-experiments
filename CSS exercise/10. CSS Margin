<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>how to set margin and padding</title>
    <style> 
        .div1{
            background-color: lightblue;
            height: 200px;
            width: 500px;
            margin: auto;
            border: solid;
            color: blue;
        }
        .span1{
            background-color: lightgreen;
            width: 100px;
            height: 50px;
            margin: auto;
            font-size: 20px;
            font-weight: bold;
            /*do not set height and width for span . size depened on conent */
        }
        .span2{
            background-color: lightcoral;
            margin-left: 50px;
            margin-right: 200px;
            /*you can set margin in 2 sides also you can use shorthand margin property */
        }
        .span3{
            background-color: lightgoldenrodyellow;
            margin-left: 20px;
            margin-right: 20px;
            
        }
        .span4{
            background-color: rgb(93, 151, 85);
            margin-left: 20px;
            margin-right: 20px;
        }
        .span5{
            background-color: rgb(214, 125, 138);
             margin-left: 20px;
        }
        .span6{
            background-color: rgb(85, 103, 206);
             margin-left: 20px;
            margin-right: 20px;
        }
        .div2{
            background-color: rgb(218, 185, 185);
            height: 200px;
            width: 500px;
            margin-top: 20px;
            border: dotted;
            color: rgb(45, 15, 216);
            border-radius: 30px;
            margin-left: 50px;
            font-size: 30px;
            font-weight: lighter;
            text-align: center;
            font-family: ;Arial, Helvetica, sans-serif;
        }
    </style>
</head>
<body>
    <div class="div1">
        <span class="span1">Span 1 txt </span>
        <span class="span2">Span 2 txt </span>
        <span class="span3">Span 3 txt </span>
        <span class="span4">Span 4 txt </span>
        <span class="span5">Span 5 txt </span>
        <span class="span6">Span 6 txt </span>
    </div>
    <div class="div2">
        <span class="span1">Span 1 txt </span>
        <span class="span2">Span 2 txt </span>
        <span class="span3">Span 3 txt </span>
        <span class="span4">Span 4 txt </span>
        <span class="span5">Span 5 txt </span>
        <span class="span6">Span 6 txt </span>
        <span>hello </span>
        <span>world</span>
    </div>
</body>
</html>
