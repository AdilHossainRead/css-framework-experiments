<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>float properties</title>
    <style>
        .parentdiv{
            background-color: rgb(164, 147, 196);
            height: 400px;
            width: 800px;
            margin: auto;
        }
        .div1{
            background-color: rgba(255, 0, 255, 0.452);
            width: 200px;
            height: 200px;
            text-align: center;
            font-size: 50px;
            float: right;
            padding-top: 50px;
        }
        .div2{
            background-color: rgb(167, 212, 41);
            width: auto;
            height: 50px;;
        }
        .div3{
            background-color: rgb(192, 166, 20);
            width: 500px;
            height: 50px;
            float: right;
        }
        .span1{
            background-color: rgb(84, 230, 230);
            font-size: 30px;
            float: left;
           
           
        }
        .span2{
            background-color: rgb(84, 138, 219); 
            font-size: 25px;
            font-style: italic;
            font-weight: 30px;
            
        }
    </style>
</head>
<body>
    <div class="parentdiv">
        <div class="div1">div 1</div>
        <span class="span1">Span text 1 </span>
        <span class="span2">Span text 2</span>
        <span class="span1">Span text 3</span>
        <span class="span2">Span text 4</span>
        <div class="div2">div 2</div>
        <div class="div3">div 3</div>
    </div>
</body>
</html>
